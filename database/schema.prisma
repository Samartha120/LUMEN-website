generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./lumen.db"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  /// bcrypt hash — never the password itself. The column is named for what it
  /// holds so nobody is tempted to compare it directly.
  passwordHash String
  name         String
  // ADMINISTRATOR | SUPERVISOR | ENGINEER are staff, created by seeding.
  // CITIZEN accounts are self-registered from the public sign-up form and can
  // only report issues and follow their own reports.
  role         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  reported      Complaint[]    @relation("ReportedBy")
  notifications Notification[]
}

model Department {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  civicCategory String      @default("ROADS") // the taxonomy category this department owns
  slaTarget     Int // target resolution hours
  users         User[]
  engineers     Engineer[]
  complaints    Complaint[]
}

model Engineer {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  phone        String
  zone         String
  skills       String // comma-separated damage classes this engineer handles
  status       String // AVAILABLE | ON_TASK | OFF_DUTY
  lat          Float // current field position, used by the assignment optimiser
  lng          Float
  resolvedJobs Int
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  complaints   Complaint[]
}

model Complaint {
  id          String @id @default(cuid())
  ref         String @unique // CMP-10245
  title       String
  description String
  zone        String
  address     String
  lat         Float
  lng         Float

  // --- Feature 1: CV detection result
  category     String // damage class predicted by the detector (e.g. "Pothole")
  civicCategory String? // civic category the class belongs to (ROADS/ELECTRICAL/WASTE/WATER/PUBLIC)
  autoRouted   Boolean @default(false) // was the department chosen by the model?
  aiPredicted  Boolean @default(false) // was the category set by the model?
  aiConfidence Float? // top detection confidence
  aiModelMode  String? // TRAINED | FALLBACK — provenance of the prediction
  detections   String? // JSON array of {label, confidence, box, area_ratio}

  // --- Feature 2: severity scoring
  severityScore Float? // 0-100 computed from detection geometry
  severityBand  String? // MINOR | MODERATE | SIGNIFICANT | SEVERE
  priority      String // LOW | MEDIUM | HIGH | CRITICAL (derived from severity)
  priorityScore Float? // explainable rule score: severity, safety, location and report pressure
  priorityFactors String? // JSON audit trail for the priority score
  slaHours      Int

  // --- Feature 3: duplicate detection
  embedding     String? // JSON array — 512-D CNN feature vector
  duplicateOfId String?
  duplicateOf   Complaint?  @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates    Complaint[] @relation("Duplicates")
  dupSimilarity Float? // cosine similarity to the primary complaint
  dupDistanceM  Float? // metres between the two reports
  dupScore      Float? // composite image, distance, category and description score
  dupCategoryMatch Boolean?
  dupDescriptionSimilarity Float?


  // --- Feature 5: assignment optimisation provenance
  assignMethod   String? // OPTIMISED | MANUAL
  assignDistance Float? // km from engineer position at time of assignment

  status    String // SUBMITTED | ASSIGNED | IN_PROGRESS | PENDING_REVIEW | CLOSED | REJECTED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  engineerId   String?
  engineer     Engineer?        @relation(fields: [engineerId], references: [id])
  images       ComplaintImage[]
  events       TimelineEvent[]

  // The citizen who reported it, when one did. Nullable because seeded and
  // staff-entered complaints have no reporter, and because a complaint must
  // outlive the account that raised it — a deleted user should not take a
  // municipal work item with them.
  reporterId String?
  reporter   User?   @relation("ReportedBy", fields: [reporterId], references: [id])

  notifications Notification[]

  // Set when a resident says the work was not actually done. Kept as its own
  // field rather than inferred from the timeline so the queue can surface
  // reopened complaints without replaying every event.
  reopenedAt DateTime?

  // --- Feature 6: repair material estimation
  // Set by the engineer on site; decides which mix the estimator uses.
  roadType     String? // BITUMINOUS | CONCRETE
  potholes     PotholeMeasurement[]

  @@index([status])
  @@index([createdAt])
}

model ComplaintImage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        String // CITIZEN | ENGINEER_BEFORE | ENGINEER_AFTER
  path        String // /uploads/<file> served from public/
  annotated   String? // /uploads/<file> with detection boxes drawn
  detections  String? // JSON detections for this specific image
  severity    Float?
  createdAt   DateTime  @default(now())
}

model TimelineEvent {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        String // CREATED | AI_DETECTION | AI_DUPLICATE | ASSIGNMENT | STATUS_CHANGE | AI_VERIFICATION
  message     String
  actor       String
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  actorRole String
  action    String
  module    String
  target    String
  details   String
  createdAt DateTime @default(now())
}

/**
 * A single pothole measured on site by the engineer's team.
 *
 * Volume and perimeter are computed on write and stored rather than derived on
 * read: they are what the material estimate and any submitted BOQ are based
 * on, so the figure that was signed off must not silently change if the
 * formula is ever adjusted.
 */
model PotholeMeasurement {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  label       String // P1, P2 ... within the complaint
  lengthM     Float
  widthM      Float
  depthM      Float
  volumeM3    Float // lengthM x widthM x depthM
  perimeterM  Float // 2 x (lengthM + widthM)
  recordedBy  String
  recordedAt  DateTime  @default(now())
  /// ESTIMATED (from the photograph) | MEASURED (on site). Everything
  /// downstream shows which, so a planning figure is never read as a survey.
  source      String    @default("MEASURED")

  @@index([complaintId])
}

/// A message to one person about one complaint.
///
/// Written when something happens that the recipient would otherwise have to
/// poll for — an engineer assigned, work started, a closure approved. Without
/// this a resident has no way to learn anything except by logging in and
/// looking, which is the difference between a dashboard and a service.
model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  type    String // ASSIGNED | STARTED | COMPLETED | CLOSED | REJECTED | REOPENED | VERIFY_FAILED
  message String
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}
