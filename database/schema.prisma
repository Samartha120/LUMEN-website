generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./lumen.db"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  name         String
  role         String // ADMINISTRATOR | SUPERVISOR | ENGINEER
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
}

model Department {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  slaTarget  Int // target resolution hours
  users      User[]
  engineers  Engineer[]
  complaints Complaint[]
}

model Engineer {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  phone        String
  zone         String
  skills       String // comma-separated damage classes this engineer handles
  status       String // AVAILABLE | ON_TASK | OFF_DUTY
  lat          Float // current field position, used by the assignment optimiser
  lng          Float
  resolvedJobs Int
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  complaints   Complaint[]
}

model Complaint {
  id          String @id @default(cuid())
  ref         String @unique // CMP-10245
  title       String
  description String
  zone        String
  address     String
  lat         Float
  lng         Float

  // --- Feature 1: CV detection result
  category     String // damage class predicted by the detector
  aiPredicted  Boolean @default(false) // was the category set by the model?
  aiConfidence Float? // top detection confidence
  aiModelMode  String? // TRAINED | FALLBACK — provenance of the prediction
  detections   String? // JSON array of {label, confidence, box, area_ratio}

  // --- Feature 2: severity scoring
  severityScore Float? // 0-100 computed from detection geometry
  severityBand  String? // MINOR | MODERATE | SIGNIFICANT | SEVERE
  priority      String // LOW | MEDIUM | HIGH | CRITICAL (derived from severity)
  slaHours      Int

  // --- Feature 3: duplicate detection
  embedding     String? // JSON array — 512-D CNN feature vector
  duplicateOfId String?
  duplicateOf   Complaint?  @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates    Complaint[] @relation("Duplicates")
  dupSimilarity Float? // cosine similarity to the primary complaint
  dupDistanceM  Float? // metres between the two reports

  // --- Feature 4: AI-verified closure
  verifyVerdict   String? // VERIFIED | INCONCLUSIVE | REJECTED
  verifyReason    String?
  verifyReduction Float? // % severity reduction measured
  verifySsim      Float?

  // --- Feature 5: assignment optimisation provenance
  assignMethod   String? // OPTIMISED | MANUAL
  assignDistance Float? // km from engineer position at time of assignment

  status    String // SUBMITTED | ASSIGNED | IN_PROGRESS | PENDING_REVIEW | CLOSED | REJECTED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  engineerId   String?
  engineer     Engineer?        @relation(fields: [engineerId], references: [id])
  images       ComplaintImage[]
  events       TimelineEvent[]

  @@index([status])
  @@index([createdAt])
}

model ComplaintImage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        String // CITIZEN | ENGINEER_BEFORE | ENGINEER_AFTER
  path        String // /uploads/<file> served from public/
  annotated   String? // /uploads/<file> with detection boxes drawn
  detections  String? // JSON detections for this specific image
  severity    Float?
  createdAt   DateTime  @default(now())
}

model TimelineEvent {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        String // CREATED | AI_DETECTION | AI_DUPLICATE | ASSIGNMENT | STATUS_CHANGE | AI_VERIFICATION
  message     String
  actor       String
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  actorRole String
  action    String
  module    String
  target    String
  details   String
  createdAt DateTime @default(now())
}
